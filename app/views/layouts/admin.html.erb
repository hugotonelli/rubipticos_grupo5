<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= [ content_for(:title), "Admin Rubípticos" ].compact.join(" · ") %></title>
    <%= render "layouts/shared/head" %>
  </head>

  <body>
    <nav class="navbar navbar-expand-md navbar-dark bg-dark mb-4">
      <div class="container">
        <%= link_to "Admin Rubípticos", admin_root_path, class: "navbar-brand fw-bold" %>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu-admin"
                aria-controls="menu-admin" aria-expanded="false" aria-label="Abrir menú">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menu-admin">
          <ul class="navbar-nav me-auto">
            <%# Links a las secciones del backend. Los que son solo para administradores van dentro de
                `if Current.user.administrador?` (y además Admin::BaseController los protege en el servidor). %>
            <% if Current.user.administrador? %>
              <li class="nav-item"><%= link_to "Crípticos", admin_cripticos_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Sincronización", admin_sincronizaciones_path, class: "nav-link" %></li>
            <% end %>
          </ul>
          <ul class="navbar-nav">
            <li class="nav-item"><%= link_to "Ver el sitio", root_path, class: "nav-link" %></li>
            <li class="nav-item">
              <%= button_to "Cerrar sesión", session_path, method: :delete, class: "btn btn-link nav-link" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <main class="container">
      <%= render "layouts/shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
