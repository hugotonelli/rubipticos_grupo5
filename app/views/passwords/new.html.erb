<% content_for :title, "Recuperar contraseña" %>

<div class="row justify-content-center">
  <div class="col-sm-10 col-md-6 col-lg-4">
    <h1 class="h3 mb-3">¿Olvidaste tu contraseña?</h1>

    <%= form_with url: passwords_path do |form| %>
      <div class="mb-3">
        <%= form.label :email_address, "Email", class: "form-label" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "form-control" %>
      </div>
      <%= form.submit "Enviar instrucciones", class: "btn btn-danger w-100" %>
    <% end %>
  </div>
</div>
