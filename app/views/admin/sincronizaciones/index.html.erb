<% content_for :title, "Sincronización" %>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-2">
  <div>
    <h1 class="h3 mb-1">Sincronización</h1>
    <p class="text-body-secondary mb-0">Trae el catálogo de crípticos desde la fuente y lo guarda en la base.</p>
  </div>
  <%= button_to admin_sincronizaciones_path, class: "btn btn-danger", data: { turbo_submits_with: "Sincronizando…" } do %>
    <i class="bi bi-arrow-repeat"></i> Sincronizar ahora
  <% end %>
</div>

<p class="small text-body-secondary text-break mb-4">
  <i class="bi bi-link-45deg"></i> <%= @configuracion.url_fuente %>
</p>

<h2 class="h6 text-uppercase text-body-secondary">Historial</h2>

<% if @sincronizaciones.empty? %>
  <p class="text-body-secondary">Todavía no hay sincronizaciones.</p>
<% else %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="small text-body-secondary">
        <tr>
          <th class="fw-normal">Fecha</th>
          <th class="fw-normal">Estado</th>
          <th class="fw-normal">Resultado</th>
          <th class="fw-normal d-none d-md-table-cell">Versión</th>
          <th class="fw-normal d-none d-lg-table-cell">Administrador</th>
        </tr>
      </thead>
      <tbody>
        <% @sincronizaciones.each do |sincronizacion| %>
          <tr>
            <td class="text-nowrap">
              <%= link_to l(sincronizacion.created_at, format: :short), admin_sincronizacion_path(sincronizacion),
                          class: "link-body-emphasis", title: "Ver informe" %>
            </td>
            <td><%= badge_de_estado(sincronizacion) %></td>
            <td><%= resultado_de(sincronizacion) %></td>
            <td class="d-none d-md-table-cell small text-body-secondary"><%= sincronizacion.version || "—" %></td>
            <td class="d-none d-lg-table-cell small text-body-secondary"><%= sincronizacion.user.email_address %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
