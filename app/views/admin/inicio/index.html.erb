<% content_for :title, "Administración" %>

<h1 class="h3 mb-3">Administración</h1>

<p>
  Ingresaste como <strong><%= Current.user.email_address %></strong>
  (<%= Current.user.administrador? ? "administrador" : "editor de puntajes" %>).
</p>

<%# TODO: sumar acá el acceso a configuración, jugadores y usuarios. %>
<div class="list-group">
  <% if Current.user.administrador? %>
    <%= link_to admin_cripticos_path, class: "list-group-item list-group-item-action" do %>
      <strong>Crípticos</strong>
      <div class="small text-body-secondary">Listado con filtros, estadísticas de juego y activar o desactivar.</div>
    <% end %>
    <%= link_to admin_sincronizaciones_path, class: "list-group-item list-group-item-action" do %>
      <strong>Sincronización</strong>
      <div class="small text-body-secondary">Traer el catálogo de crípticos desde la fuente y ver los informes.</div>
    <% end %>
  <% end %>
</div>
